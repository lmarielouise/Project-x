generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  githubRepo  String
  githubToken String?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      Event[]
}

model Event {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  url         String?
  author      String?
  avatarUrl   String?
  externalId  String?
  metadata    String?
  happenedAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([projectId, externalId])
  @@index([projectId, happenedAt])
}
